---
import { siteConfig } from "../lib/siteConfig";
import CheckIcon from "./CheckIcon.astro";

const perks = ["14-day free trial — no key, no account", "Every feature, no tiers", "Free updates", "Works fully offline"];
---

<section id="pricing" class="section">
  <div class="wrap section-pad">
    <h2 class="section-title">One price, yours for good</h2>
    <p style="margin:0 0 40px;max-width:52ch;font-size:15px" class="text-muted">No subscription. Buy once, use it forever, updates included.</p>

    <div class="rule-grid" style="--min:320px;--bleed:34px;border-top:2px solid var(--color-divider)">
      <div class="rule-cell" style="padding:32px">
        <div style="font-family:var(--font-heading);font-weight:800;font-size:clamp(40px,5vw,64px);line-height:0.9;letter-spacing:-0.04em">{siteConfig.price}</div>
        <p style="margin:12px 0 24px;font-size:13px" class="text-muted">{siteConfig.priceNote}</p>
        <a href={siteConfig.checkoutUrl} class="btn btn-primary" style="text-decoration:none;height:48px;padding:0 24px;font-size:15px">Buy Bookmarc</a>
        <div style="margin-top:28px;display:flex;flex-direction:column;gap:10px;font-size:14px">
          {
            perks.map((perk) => (
              <div style="display:flex;align-items:center;gap:10px">
                <CheckIcon />
                {perk}
              </div>
            ))
          }
        </div>
      </div>

      <div class="rule-cell" style="padding:32px">
        <div style="font-size:12px;letter-spacing:0.1em;text-transform:uppercase;margin-bottom:20px" class="text-muted">Available for</div>

        <a href={siteConfig.downloads.mac} class="platform">
          <span style="display:flex;align-items:center;gap:12px">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" aria-hidden="true"><rect x="3" y="4" width="18" height="12"></rect><path d="M2 20h20"></path></svg>
            <span class="platform-name">macOS</span>
          </span>
          <span style="font-size:12.5px" class="text-muted">Apple silicon &amp; Intel · .dmg</span>
        </a>
        <a href={siteConfig.downloads.windows} class="platform">
          <span style="display:flex;align-items:center;gap:12px">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" aria-hidden="true"><rect x="3" y="3" width="7.5" height="7.5"></rect><rect x="13.5" y="3" width="7.5" height="7.5"></rect><rect x="3" y="13.5" width="7.5" height="7.5"></rect><rect x="13.5" y="13.5" width="7.5" height="7.5"></rect></svg>
            <span class="platform-name">Windows</span>
          </span>
          <span style="font-size:12.5px" class="text-muted">Windows 10 and later · .exe</span>
        </a>
        <a href={siteConfig.downloads.linux} class="platform">
          <span style="display:flex;align-items:center;gap:12px">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" aria-hidden="true"><path d="M4 17l5-5-5-5"></path><path d="M12 19h8"></path></svg>
            <span class="platform-name">Linux</span>
          </span>
          <span style="font-size:12.5px" class="text-muted">AppImage &amp; .deb</span>
        </a>

        <p style="margin:20px 0 0;font-size:12.5px" class="text-muted">Your license activates every platform. The library file moves between them untouched.</p>
      </div>
    </div>
  </div>
</section>

<style>
  .platform {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    padding: 16px 0;
    border-bottom: 1px solid var(--color-divider);
    color: inherit;
    text-decoration: none;
  }
  .platform:hover {
    color: var(--accent-ink);
  }
  .platform-name {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 20px;
  }
</style>
