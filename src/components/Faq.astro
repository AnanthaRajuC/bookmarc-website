---
import { siteConfig } from "../lib/siteConfig";

const faqs = [
  {
    q: "Does Bookmarc sync across my devices?",
    a: "No, by design. Your library lives in one SQLite file on the computer you're using. Optional end-to-end encrypted sync is on the roadmap, and it will always be opt-in.",
  },
  {
    q: "Which browsers can I import from?",
    a: "Chrome, Chromium, Edge, Brave and Firefox are read directly from their own bookmark files. Any other browser, Safari included, works through its standard \"Export bookmarks\" HTML file, and exports from Pocket, Raindrop and Pinboard can be imported too.",
  },
  {
    q: "Can I save pages straight from my browser?",
    a: "Yes. The extension for Chrome, Edge, Brave and Firefox adds a toolbar button, a right-click option and a keyboard shortcut, and can pass along each new bookmark you make in the browser. It only talks to Bookmarc on your own computer; if the app is closed, pages wait and are sent when it opens. It isn't in the browser stores yet — for now you load it from a folder that comes with the app.",
  },
  {
    q: "Does Bookmarc keep copies of the pages I bookmark?",
    a: "Only if you ask. You can save a readable copy of a page, or your whole library, so it opens even if the site changes or disappears, and search inside it. Copies are downloaded straight from the site to your computer, stored in their own file, and keep just the article text — not scripts, styles or images.",
  },
  {
    q: "Is there a free trial?",
    a: "Yes. Every feature works for 14 days from your first launch, with no license key and no account. When it ends your bookmarks are untouched — you just need a key to keep using the app.",
  },
  {
    q: "Is there a subscription?",
    a: "No. Bookmarc is a one-time purchase that activates the app with a license key, and updates are free.",
  },
  {
    q: "What happens if I lose internet access?",
    a: "Nothing changes — the app works fully offline. License validation has an offline grace period, so a network hiccup never locks you out mid-session.",
  },
  {
    q: "Can I get my data out if I stop using Bookmarc?",
    a: "Yes. Export the full library as CSV, JSON or Markdown at any time, or simply copy the underlying SQLite file.",
  },
];
---

<section id="faq" class="section">
  <div class="wrap section-pad">
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(300px,100%),1fr));gap:clamp(24px,4vw,64px)">
      <div>
        <h2 class="section-title">Questions</h2>
        <p style="margin:0;font-size:14px" class="text-muted">
          Anything else: <a href={`mailto:${siteConfig.supportEmail}`}>{siteConfig.supportEmail}</a>
        </p>
      </div>
      <div>
        {
          faqs.map((item, i) => (
            <details class:list={["faq-item", { "is-last": i === faqs.length - 1 }]}>
              <summary>
                {item.q}
                <span style="flex:none;color:var(--accent-ink);font-size:18px">+</span>
              </summary>
              <p style="margin:12px 0 0;font-size:14px;line-height:1.6">{item.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .faq-item {
    border-top: 2px solid var(--color-divider);
    padding: 18px 0;
  }
  .faq-item.is-last {
    border-bottom: 2px solid var(--color-divider);
  }
  .faq-item summary {
    display: flex;
    cursor: pointer;
    align-items: baseline;
    justify-content: space-between;
    gap: 16px;
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 16px;
  }
</style>
