---
const points = [
  { title: "One SQLite file", body: "Your whole library is a single local database on your computer. Nothing is uploaded anywhere." },
  { title: "No account", body: "No sign-up, no login, no email address to use the app day to day." },
  {
    title: "No telemetry",
    body: "Bookmarc doesn't phone home. A link check, a site icon or a saved copy goes straight to that site from your computer, never a Bookmarc server.",
  },
  {
    title: "Copies stay yours",
    body: "Saved page copies are opt-in and kept in their own local file. Only the readable text is stored — no scripts, styles or images.",
  },
  {
    title: "The extension stays local",
    body: "It reaches Bookmarc over a local-only connection that is off until you switch it on, guarded by a code only you have. Web pages can't use it.",
  },
  {
    title: "License, not subscription",
    body: "One purchase activates the app. Validation has an offline grace period, so a network hiccup never locks you out.",
  },
];
---

<section id="privacy" class="section" style="background:var(--color-accent);color:#fff">
  <div class="wrap section-pad">
    <div style="font-size:12px;letter-spacing:0.1em;text-transform:uppercase;margin-bottom:24px;font-weight:600;color:#201e1d">Local-first, actually</div>
    <h2 style="margin:0;font-size:clamp(32px,5.2vw,64px);line-height:1;letter-spacing:-0.03em;max-width:22ch">
      There is no server for your bookmarks to sync to.
    </h2>
  </div>
</section>

<section class="section">
  <div class="wrap section-pad">
    <div class="rule-grid" style="--min:240px">
      {
        points.map((p) => (
          <div class="rule-cell">
            <h4 style="margin:0 0 6px;font-size:16px">{p.title}</h4>
            <p style="margin:0;font-size:13.5px;line-height:1.55">{p.body}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
