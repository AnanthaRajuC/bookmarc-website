---
interface Props {
  size?: "sm" | "lg";
}
const { size = "lg" } = Astro.props;
const [w, h] = size === "lg" ? [22, 28] : [18, 22];
---

<svg style={`width:${w}px;height:${h}px;flex:none;color:var(--color-accent)`} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
  <path d="M6 4h12a1 1 0 0 1 1 1v15l-7-4.5L5 20V5a1 1 0 0 1 1-1z"></path>
</svg>
