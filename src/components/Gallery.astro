---
const shots = [
  {
    src: "images/screenshot-analytics.png",
    title: "Analytics",
    body: "Bookmarking activity over time, top hosts, category breakdown, and a Library Health card tying dead links and duplicates together.",
  },
  {
    src: "images/screenshot-category-rules.png",
    title: "Category Rules",
    body: "A seeded set of host-to-category rules that auto-organize new bookmarks on import — extend or edit them any time.",
  },
  {
    src: "images/screenshot-quicklinks.png",
    title: "Quick Links",
    body: "Group frequently used URLs by name and open every one of them as a new browser tab with a single click.",
  },
];
---

<section class="mx-auto max-w-6xl px-5 py-20">
  <div class="mx-auto mb-12 max-w-xl text-center">
    <h2 class="text-[28px] font-extrabold tracking-tight text-text sm:text-[34px]">More than a list of links</h2>
    <p class="mt-3 text-[14.5px] leading-relaxed text-text-secondary">A closer look at a few of the screens above.</p>
  </div>

  <div class="grid grid-cols-1 gap-6 lg:grid-cols-3">
    {
      shots.map((shot) => (
        <div class="flex flex-col overflow-hidden rounded-2xl border border-border bg-surface shadow-[0_10px_30px_-8px_rgba(40,32,20,0.14)]">
          <img
            src={`${import.meta.env.BASE_URL}${shot.src}`}
            alt={`The Bookmarc ${shot.title} screen`}
            width="1280"
            height="832"
            loading="lazy"
            class="w-full border-b border-border"
          />
          <div class="p-5">
            <div class="mb-1.5 text-[14px] font-bold text-text">{shot.title}</div>
            <p class="text-[12.5px] leading-relaxed text-text-secondary">{shot.body}</p>
          </div>
        </div>
      ))
    }
  </div>
</section>
