---
const features = [
  {
    title: "Import from anywhere",
    body: "Five browsers read straight from their own files, everything else through an HTML export — plus Pocket, Raindrop and Pinboard, tags and notes included.",
  },
  {
    title: "Add a bookmark in two seconds",
    body: "Paste a URL and it's saved. A first-run checklist orients new users without getting in the way.",
  },
  {
    title: "Organize your way",
    body: "Folders, rule-based categories, tags, notes and a read/unread flag, in any combination.",
  },
  {
    title: "Smart filters & Quick Links",
    body: "Save a search as a live view, or group URLs and open the whole set in new tabs with one click.",
  },
  {
    title: "Find what's broken",
    body: "An async dead-link checker flags pages that no longer load; Duplicates groups repeat saves.",
  },
  {
    title: "Know your habits",
    body: "Activity over time, top hosts, category breakdowns, and a Library Health card that ties it together.",
  },
  {
    title: "Built for the keyboard",
    body: "A command palette on Ctrl/Cmd+K, and full arrow-key navigation for browsing and opening.",
  },
  {
    title: "Never lose your data",
    body: "Automatic local SQLite backups with one-click restore, plus CSV, JSON and Markdown export.",
  },
  {
    title: "A home that helps",
    body: "Open on a Home screen: search at once, see what needs a look, jump back to recent bookmarks.",
  },
  {
    title: "Save from your browser",
    body: "An extension for Chrome, Edge, Brave and Firefox sends the page you're on to the app on your own computer.",
  },
  {
    title: "Keep a copy of a page",
    body: "Save a readable copy locally so a page still opens if the site changes — and search inside it.",
  },
  {
    title: "Speaks your language",
    body: "English, Spanish, German, French, Japanese and Brazilian Portuguese, picked from your system.",
  },
];
---

<section id="features" class="section">
  <div class="wrap section-pad">
    <div style="display:flex;flex-wrap:wrap;align-items:baseline;justify-content:space-between;gap:16px;margin-bottom:40px">
      <h2 class="section-title" style="margin:0">Everything a bookmark deserves</h2>
      <p style="margin:0;max-width:46ch;font-size:14px" class="text-muted">
        A proper library rather than a list of links: organization, health checking, and insight your browser never offered.
      </p>
    </div>
    <div class="rule-grid" style="--min:280px">
      {
        features.map((f, i) => (
          <div class="rule-cell">
            <div style="font-size:11px;letter-spacing:0.1em;color:var(--accent-ink);margin-bottom:10px">{String(i + 1).padStart(2, "0")}</div>
            <h4 style="margin:0 0 6px;font-size:17px">{f.title}</h4>
            <p style="margin:0;font-size:13.5px;line-height:1.55">{f.body}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
