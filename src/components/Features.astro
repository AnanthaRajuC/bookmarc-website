<section id="features" class="mx-auto max-w-6xl px-5 py-20">
  <div class="mx-auto mb-12 max-w-xl text-center">
    <h2 class="text-[28px] font-extrabold tracking-tight text-text sm:text-[34px]">Everything a bookmark deserves</h2>
    <p class="mt-3 text-[14.5px] leading-relaxed text-text-secondary">
      Not just a list of links — a proper library, with the organization, health-checking, and insight tools your
      browser's built-in bookmarks never gave you.
    </p>
  </div>

  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
    {
      features.map((f) => (
        <div class="rounded-2xl border border-border bg-surface p-5">
          <div class="mb-3 h-2 w-2 rounded-full bg-accent" />
          <div class="mb-1.5 text-[14px] font-bold text-text">{f.title}</div>
          <p class="text-[12.5px] leading-relaxed text-text-secondary">{f.body}</p>
        </div>
      ))
    }
  </div>
</section>
