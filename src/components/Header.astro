---
import Logo from "./Logo.astro";
import { siteConfig } from "../lib/siteConfig";
---

<header class="sticky top-0 z-20 border-b border-border bg-surface/85 backdrop-blur">
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between px-5">
    <a href={import.meta.env.BASE_URL} class="flex items-center gap-2.5">
      <Logo />
      <span class="text-[15px] font-extrabold tracking-tight text-text">{siteConfig.name}</span>
    </a>

    <nav class="hidden items-center gap-7 text-[13.5px] font-semibold text-text-secondary md:flex">
      <a href={`${import.meta.env.BASE_URL}#features`} class="hover:text-text">Features</a>
      <a href={`${import.meta.env.BASE_URL}#privacy`} class="hover:text-text">Privacy</a>
      <a href={`${import.meta.env.BASE_URL}#pricing`} class="hover:text-text">Pricing</a>
      <a href={`${import.meta.env.BASE_URL}#faq`} class="hover:text-text">FAQ</a>
      <a href={siteConfig.githubRepoUrl} class="hover:text-text">GitHub</a>
    </nav>

    <div class="flex items-center gap-2.5">
      <button
        id="theme-toggle"
        title="Toggle theme"
        class="flex h-8 w-8 shrink-0 items-center justify-center rounded-[10px] border border-border-strong text-text-secondary hover:bg-surface-2"
      >
        <svg id="theme-icon-sun" class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v3M12 19v3M2 12h3M19 12h3M4.9 4.9l2.1 2.1M17 17l2.1 2.1M4.9 19.1L7 17M17 7l2.1-2.1"></path>
        </svg>
        <svg id="theme-icon-moon" class="hidden h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M20 14.5A8.5 8.5 0 1 1 9.5 4a7 7 0 0 0 10.5 10.5z"></path>
        </svg>
      </button>
      <a
        href={`${import.meta.env.BASE_URL}#pricing`}
        class="hidden h-9 items-center rounded-[11px] bg-accent-solid px-4 text-[13px] font-bold text-white hover:bg-accent-solid-hover sm:flex"
      >
        Download
      </a>
    </div>
  </div>
</header>

<script>
  const STORAGE_KEY = "bookmarc-site-theme";
  const button = document.getElementById("theme-toggle")!;
  const sun = document.getElementById("theme-icon-sun")!;
  const moon = document.getElementById("theme-icon-moon")!;

  function syncIcon() {
    const dark = document.documentElement.classList.contains("dark");
    sun.classList.toggle("hidden", dark);
    moon.classList.toggle("hidden", !dark);
  }

  button.addEventListener("click", () => {
    const dark = document.documentElement.classList.toggle("dark");
    localStorage.setItem(STORAGE_KEY, dark ? "dark" : "light");
    syncIcon();
  });

  syncIcon();
</script>
