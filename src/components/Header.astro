---
import Logo from "./Logo.astro";
import { siteConfig } from "../lib/siteConfig";

const base = import.meta.env.BASE_URL;
const links = [
  { href: "#how", label: "How it works" },
  { href: "#features", label: "Features" },
  { href: "#compare", label: "Compare" },
  { href: "#privacy", label: "Privacy" },
  { href: "#pricing", label: "Pricing" },
  { href: "#changelog", label: "Releases" },
];
---

<header style="position:sticky;top:0;z-index:30;background:var(--color-bg);border-bottom:2px solid var(--color-divider)">
  <div class="wrap" style="display:flex;align-items:center;gap:24px;padding-block:14px">
    <a href={`${base}#top`} style="display:flex;align-items:center;gap:10px;color:inherit;text-decoration:none;margin-right:auto">
      <Logo />
      <span style="font-family:var(--font-heading);font-weight:800;font-size:19px;letter-spacing:0.06em;text-transform:uppercase">{siteConfig.name}</span>
    </a>

    <nav style="display:flex;flex-wrap:wrap;align-items:center;gap:10px 22px;font-size:14px">
      {links.map((l) => <a href={`${base}${l.href}`} class="nav-link">{l.label}</a>)}
    </nav>

    <div style="display:flex;align-items:center;gap:10px">
      <button id="theme-toggle" class="theme-toggle" title="Toggle theme" aria-label="Toggle theme">
        <svg id="theme-icon-moon" style="width:17px;height:17px" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <path d="M20 14.5A8.5 8.5 0 1 1 9.5 4a7 7 0 0 0 10.5 10.5z"></path>
        </svg>
        <svg id="theme-icon-sun" style="width:17px;height:17px" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v3M12 19v3M2 12h3M19 12h3M4.9 4.9l2.1 2.1M17 17l2.1 2.1M4.9 19.1L7 17M17 7l2.1-2.1"></path>
        </svg>
      </button>
      <a href={`${base}#pricing`} class="btn btn-primary" style="text-decoration:none;height:36px">Download</a>
    </div>
  </div>
</header>

<style>
  .theme-toggle {
    display: flex;
    width: 36px;
    height: 36px;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--color-divider);
    background: transparent;
    color: inherit;
    cursor: pointer;
  }
  .theme-toggle:hover {
    background: color-mix(in srgb, var(--color-text) 7%, transparent);
  }
  /* Show the moon in dark mode (the icon of the current theme), the sun in light. */
  :global([data-theme="dark"]) #theme-icon-sun,
  :global([data-theme="light"]) #theme-icon-moon {
    display: none;
  }
</style>

<script>
  const STORAGE_KEY = "bookmarc-site-theme";

  document.getElementById("theme-toggle")!.addEventListener("click", () => {
    const next = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
    document.documentElement.dataset.theme = next;
    try {
      localStorage.setItem(STORAGE_KEY, next);
    } catch {}
  });
</script>
