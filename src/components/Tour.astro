---
const tours = [
  {
    label: "Saved copies",
    src: "images/screenshot-reader.png",
    alt: "The Bookmarc Saved copies screen: a readable local copy of a saved page, searchable alongside the bookmark it belongs to.",
    caption: "Saved copies — keep a readable copy of any page on your computer, so it still opens if the site changes or disappears, and search inside it.",
  },
  {
    label: "Filters",
    src: "images/screenshot-filters.png",
    alt: "The Bookmarc Filters screen: a filter panel narrowing the list by browser, file type and social site, with separate searches for title, host, category, tag and notes.",
    caption: "Filters & column search — narrow the list by browser, file type or social site, and search title, host, category, tag and notes on their own.",
  },
  {
    label: "Extension",
    src: "images/screenshot-extension.png",
    alt: "The Bookmarc browser extension screen: settings for the local-only connection that lets Chrome, Edge, Brave and Firefox send saved pages to the app.",
    caption: "Browser extension — save from Chrome, Edge, Brave or Firefox. Off until you switch it on, and it only talks to the app on your own computer.",
  },
  {
    label: "Analytics",
    src: "images/screenshot-analytics.png",
    alt: "Bookmarc's Analytics screen: totals for bookmarks, additions this week, top host and uncategorized share, over a bookmarking-activity chart, a top-hosts bar list and a category distribution breakdown.",
    caption: "Analytics — activity over time, top hosts, category breakdown, and a Library Health card tying dead links and duplicates together.",
  },
  {
    label: "Category Rules",
    src: "images/screenshot-category-rules.png",
    alt: "Bookmarc's Category Rules screen: a searchable list of host-to-category rules, each with its bookmark count and reclassify and delete actions, above a form for adding a new rule.",
    caption: "Category Rules — a seeded set of host-to-category rules that auto-organize new bookmarks on import.",
  },
  {
    label: "Quick Links",
    src: "images/screenshot-quicklinks.png",
    alt: "Bookmarc's Quick Links screen: named groups of URLs, each with an Open all action, above a form for adding a group from one URL per line.",
    caption: "Quick Links — group frequently used URLs by name and open every one as a new browser tab with a single click.",
  },
];
const base = import.meta.env.BASE_URL;
---

<section id="tour" class="section" style="background:var(--color-surface)" data-tour>
  <div class="wrap section-pad">
    <h2 class="section-title">A look inside</h2>
    <p style="margin:0 0 24px;max-width:52ch;font-size:15px" class="text-muted">Six more screens, past the Home screen above.</p>

    <div role="tablist" style="display:flex;flex-wrap:wrap;border-top:2px solid var(--color-divider);border-bottom:2px solid var(--color-divider);margin-bottom:24px">
      {
        tours.map((t, i) => (
          <button type="button" role="tab" class:list={["tour-tab", { "is-active": i === 0 }]} aria-selected={i === 0} data-tour-tab>
            <span style="font-size:11px;letter-spacing:0.1em">{String(i + 1).padStart(2, "0")}</span>
            <span style="font-size:13px;letter-spacing:-0.01em">{t.label}</span>
          </button>
        ))
      }
    </div>

    <div style="overflow:hidden;border:2px solid var(--color-divider);background:var(--color-bg)">
      <div class="tour-track" data-tour-track>
        {
          tours.map((t, i) => (
            <figure style="flex:0 0 100%">
              <img
                src={`${base}${t.src}`}
                alt={t.alt}
                width="1280"
                height="832"
                loading={i === 0 ? "eager" : "lazy"}
                style="width:100%;height:auto;aspect-ratio:1280/832;object-fit:cover;object-position:top left"
              />
            </figure>
          ))
        }
      </div>
    </div>

    <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:24px;margin-top:14px">
      <p style="margin:0;max-width:60ch;font-size:13px" data-tour-caption aria-live="polite">{tours[0].caption}</p>
      <div style="display:flex;gap:8px;flex:0 0 auto">
        <button type="button" class="tour-arrow" aria-label="Previous screen" data-tour-prev>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"></path></svg>
        </button>
        <button type="button" class="tour-arrow" aria-label="Next screen" data-tour-next>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"></path></svg>
        </button>
      </div>
    </div>
  </div>
</section>

<script is:inline define:vars={{ captions: tours.map((t) => t.caption) }}>
  const root = document.querySelector("[data-tour]");
  const tabs = Array.from(root.querySelectorAll("[data-tour-tab]"));
  const track = root.querySelector("[data-tour-track]");
  const caption = root.querySelector("[data-tour-caption]");
  let current = 0;

  function go(i) {
    current = (i + tabs.length) % tabs.length;
    track.style.transform = `translateX(-${current * 100}%)`;
    caption.textContent = captions[current];
    tabs.forEach((tab, n) => {
      tab.classList.toggle("is-active", n === current);
      tab.setAttribute("aria-selected", String(n === current));
    });
  }

  tabs.forEach((tab, n) => tab.addEventListener("click", () => go(n)));
  root.querySelector("[data-tour-prev]").addEventListener("click", () => go(current - 1));
  root.querySelector("[data-tour-next]").addEventListener("click", () => go(current + 1));
</script>

<style>
  .tour-tab {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 14px 18px 14px 0;
    margin: 0 26px -2px 0;
    border: 0;
    border-bottom: 2px solid transparent;
    background: transparent;
    cursor: pointer;
    font-family: inherit;
    text-align: left;
    color: var(--color-text);
    opacity: 0.6;
  }
  .tour-tab.is-active {
    border-bottom-color: var(--color-accent);
    color: var(--accent-ink);
    opacity: 1;
  }
  .tour-track {
    display: flex;
    will-change: transform;
    transition: transform 380ms cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .tour-arrow {
    width: 40px;
    height: 40px;
    display: grid;
    place-items: center;
    border: 2px solid var(--color-divider);
    background: transparent;
    color: var(--color-text);
    cursor: pointer;
  }
  .tour-arrow:hover {
    background: var(--color-accent);
    border-color: var(--color-accent);
    color: #fff;
  }
</style>
