---
import { siteConfig } from "../lib/siteConfig";
---

<section class="mx-auto max-w-4xl px-5 pb-16 pt-20 text-center sm:pt-28">
  <div class="mb-5 inline-flex items-center gap-1.5 rounded-full border border-border bg-surface px-3 py-1 text-[12px] font-semibold text-text-secondary">
    <span class="h-1.5 w-1.5 rounded-full bg-success"></span>
    Local-first · No account · No telemetry
  </div>

  <h1 class="mx-auto max-w-2xl text-[38px] font-extrabold leading-[1.1] tracking-tight text-text sm:text-[52px]">
    A bookmark manager that stays <span class="text-accent">on your computer</span>.
  </h1>

  <p class="mx-auto mt-5 max-w-xl text-[15.5px] leading-relaxed text-text-secondary sm:text-[17px]">
    {siteConfig.description}
  </p>

  <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
    <a
      href="#pricing"
      class="flex h-11 items-center rounded-[12px] bg-accent-solid px-6 text-[14px] font-bold text-white hover:bg-accent-solid-hover"
    >
      Get Bookmarc — {siteConfig.price}
    </a>
    <a
      href="#features"
      class="flex h-11 items-center rounded-[12px] border border-border-strong px-6 text-[14px] font-bold text-text hover:bg-surface-2"
    >
      See what it does
    </a>
  </div>

  <p class="mt-4 text-[12px] text-text-tertiary">One-time purchase. Works offline. Your bookmarks never leave your device.</p>
</section>

<section class="mx-auto max-w-5xl px-5 pb-20">
  <div class="overflow-hidden rounded-2xl border border-border bg-surface shadow-[0_10px_30px_-8px_rgba(40,32,20,0.14)]">
    <div class="flex items-center gap-1.5 border-b border-border bg-surface-2 px-4 py-2.5">
      <span class="h-2.5 w-2.5 rounded-full bg-border-strong"></span>
      <span class="h-2.5 w-2.5 rounded-full bg-border-strong"></span>
      <span class="h-2.5 w-2.5 rounded-full bg-border-strong"></span>
    </div>
    <img
      src={`${import.meta.env.BASE_URL}images/screenshot.png`}
      alt="The Bookmarc app showing a bookmark list with folders, categories, and tags in the sidebar"
      width="1280"
      height="832"
      class="w-full"
    />
  </div>
</section>
