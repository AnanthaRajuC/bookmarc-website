---
const stats = [
  { value: "5", label: "browsers read directly", detail: "Chrome, Chromium, Edge, Brave, Firefox" },
  { value: "1", label: "file holds everything", detail: "One local SQLite database" },
  { value: "0", label: "servers involved", detail: "Nothing to sync, nothing to leak" },
  { value: "3", label: "ways out, any time", detail: "CSV, JSON, Markdown" },
];
---

<section class="section">
  <div class="wrap" style="padding-block:clamp(40px,6vw,88px) clamp(32px,4vw,56px)">
    <div style="font-size:12px;letter-spacing:0.1em;text-transform:uppercase;color:var(--accent-ink);font-weight:600;margin-bottom:24px">
      Local-first desktop bookmark manager
    </div>
    <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(min(420px,100%),1fr));gap:clamp(24px,4vw,64px);align-items:end">
      <h1 style="margin:0;font-size:clamp(40px,6.4vw,78px);line-height:0.98;letter-spacing:-0.03em">
        A bookmark library that<br />lives <span style="color:var(--color-accent)">on your computer</span>.
      </h1>
      <div>
        <p style="margin:0 0 24px;font-size:clamp(15px,1.4vw,18px);line-height:1.5;max-width:44ch;text-wrap:pretty">
          Bookmarc imports from every browser, organizes with folders, categories and tags, finds the dead links and duplicates you've collected, keeps readable copies of pages, and saves straight from your browser. No account. No server. No telemetry.
        </p>
        <div style="display:flex;flex-wrap:wrap;gap:12px">
          <a href="#pricing" class="btn btn-primary" style="text-decoration:none;height:44px;padding:0 20px;font-size:15px">Get Bookmarc</a>
          <a href="#features" class="btn btn-secondary" style="text-decoration:none;height:44px;padding:0 20px;font-size:15px;color:var(--color-text)">See what it does</a>
        </div>
        <p style="margin:16px 0 0;font-size:12.5px" class="text-muted">
          14-day free trial, no account · One-time purchase · Works offline · macOS, Windows, Linux
        </p>
      </div>
    </div>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <div class="rule-grid" style="--min:220px">
      {
        stats.map((s) => (
          <div class="rule-cell" style="padding:28px 24px">
            <div style="font-family:var(--font-heading);font-weight:800;font-size:40px;line-height:1;letter-spacing:-0.02em">{s.value}</div>
            <div style="margin-top:8px;font-size:13px;line-height:1.4">
              {s.label}<br /><span class="text-muted">{s.detail}</span>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<section class="section" style="background:var(--color-surface)">
  <div class="wrap" style="padding-block:clamp(32px,4vw,56px)">
    <div style="border:2px solid var(--color-divider);background:var(--color-bg)">
      <div style="display:flex;align-items:center;gap:8px;border-bottom:2px solid var(--color-divider);padding:10px 14px">
        <span style="width:10px;height:10px;background:var(--color-divider)"></span>
        <span style="width:10px;height:10px;background:var(--color-divider)"></span>
        <span style="width:10px;height:10px;background:var(--color-divider)"></span>
        <span style="margin-left:12px;font-size:11px;letter-spacing:0.08em;text-transform:uppercase" class="text-muted">Bookmarc — Home</span>
      </div>
      <img
        src={`${import.meta.env.BASE_URL}images/screenshot.png`}
        alt="The Bookmarc Home screen: a search box, items that need attention, recently added bookmarks, and shortcuts to saved views."
        width="1280"
        height="832"
        style="width:100%;height:auto;aspect-ratio:1280/832;object-fit:cover;object-position:top left"
      />
    </div>
  </div>
</section>
